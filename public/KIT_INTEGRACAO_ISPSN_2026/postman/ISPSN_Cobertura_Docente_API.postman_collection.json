          "raw": "{\n  \"metricas\": [\n    {\n      \"turma_id\": \"FISIO3MA-D1232\",\n      \"sumarios_registados\": 160,\n      \"sumarios_previstos\": 200,\n      \"programa_carregado\": 1,\n      \"dosificacao_carregada\": 1,\n      \"notas_no_prazo\": \"Sim\",\n      \"inquerito_media\": 4.75\n    }\n  ]\n}"
