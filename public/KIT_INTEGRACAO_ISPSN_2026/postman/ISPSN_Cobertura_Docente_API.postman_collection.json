      "name": "1. Healthcheck e Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "https://docentes.ispsn.app/index.php?api=v1_integracao_status",
          "protocol": "https",
          "host": ["docentes", "ispsn", "app"],
          "path": ["index.php"],
          "query": [
            { "key": "api", "value": "v1_integracao_status" }
          ]
        }
      }
    },
    {
      "name": "2. Exportar Matriz Homologada (Fisioterapia)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "https://docentes.ispsn.app/index.php?api=v1_integracao_plano_export&curso_id=8&ano=2026/27",
          "protocol": "https",
          "host": ["docentes", "ispsn", "app"],
          "path": ["index.php"],
          "query": [
            { "key": "api", "value": "v1_integracao_plano_export" },
            { "key": "curso_id", "value": "8" },
            { "key": "ano", "value": "2026/27" }
          ]
        }
      }
    },
    {
      "name": "3. Sincronizar Docentes (ERP -> Cobertura)",
      "request": {
